# Variáveis do treinamento DS-101: valores padrão. Este arquivo vai no pacote e fica genérico.
# Os valores da SUA máquina e os segredos vão em .env.local (mesmo formato). Ele sobrescreve
# este arquivo e NUNCA vai no pacote. Carregue os dois com: source setup/config.env

# ── GCP ──────────────────────────────────────────────────────────────────────────────
# Projeto COM BILLING habilitado (custo estimado: centavos). No sandbox, partições com mais
# de 60 dias expiram, e a janela do caso tem 90.
GCP_PROJECT="SEU-PROJETO-GCP"
BQ_LOCATION="US"          # thelook_ecommerce fica em US; os datasets precisam estar na mesma região
DATA_REF=""               # vazio = hoje. Âncora da janela (use o dia do treinamento)
# Opcional, se você tiver mais de uma config no gcloud (gcloud config configurations list):
# CLOUDSDK_ACTIVE_CONFIG_NAME="nome-da-config-com-a-conta-certa"

# ── Jira (usado pela skill /jira-preencher) ─────────────────────────────────────────
# Gere o token em: https://id.atlassian.com/manage-profile/security/api-tokens
# Cole o token só no .env.local, nunca aqui.
JIRA_API_TOKEN=""
