# Carrega as variáveis do treinamento: ../.env (padrões) e ../.env.local (esta máquina + segredos).
# Uso: source setup/config.env   (funciona em bash e em zsh; todas as variáveis são exportadas)
if [ -n "${BASH_SOURCE:-}" ]; then _cfg_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
else _cfg_dir="$(cd "$(dirname "${(%):-%x}")/.." && pwd)"; fi
set -a
source "$_cfg_dir/.env"
[ -f "$_cfg_dir/.env.local" ] && source "$_cfg_dir/.env.local"
set +a
unset _cfg_dir
